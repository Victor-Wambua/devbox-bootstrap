#!/bin/bash
# Mock curl: serves fixtures from $MOCK_STATE/curl/<url with / and : replaced by _>.
# shellcheck source=lib.sh
. "$MOCKS_DIR/lib.sh"
out="" url=""
while [ $# -gt 0 ]; do
  case $1 in
    -o) out=$2; shift ;;
    --proto | --tlsv1.2) [ "$1" = "--proto" ] && shift ;;
    -*) ;;
    *) url=$1 ;;
  esac
  shift
done
mock_mutation "curl $url"
key=$(printf '%s' "$url" | tr '/:' '__')
if [ ! -f "$MOCK_STATE/curl/$key" ]; then
  echo "curl: (22) mock: no fixture for $url" >&2
  exit 22
fi
cp "$MOCK_STATE/curl/$key" "$out"
